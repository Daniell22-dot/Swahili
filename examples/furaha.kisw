# --------------------------------------------------------
#  Furaha — arrays, sorting and shuffling with builtins.
#  Run: python -m swahili examples/furaha.kisw
# --------------------------------------------------------

tumia hesabu
andika "Furaha!"

orodha = [5, 1, 3, 4, 2]

andika f"Orodha: {orodha}"
andika f"Idadi: {idadi(orodha)}"
andika f"Imepangwa: {pangilia(orodha)}"
andika f"Imechanganywa: {pinganya(orodha)}"
andika f"Jumla: {hesabu.jumlisha(orodha)}"

andika "Furaha!"